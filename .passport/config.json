{
  "schema_version": 1,
  "enabled": true,
  "mode": "advisory",
  "change_classes": [
    {
      "name": "documentation",
      "paths": [
        "docs/**",
        "*.md"
      ],
      "depth": "Light"
    },
    {
      "name": "tests",
      "paths": [
        "tests/**"
      ],
      "depth": "Light"
    },
    {
      "name": "trivial",
      "paths": [
        "*.txt"
      ],
      "depth": "None"
    }
  ],
  "default_depth": "Standard",
  "sensitive_paths": [
    ".github/workflows/**",
    "**/auth/**",
    "auth/**",
    "payments/**",
    "**/migrations/**"
  ],
  "owners": [],
  "human_authorities": [],
  "agent_accounts": [],
  "state_location": "pr-comment",
  "model": {
    "enabled": false,
    "provider": "openai",
    "model": "gpt-5.4-mini",
    "timeout_seconds": 45
  },
  "routing": {
    "technical": "agent",
    "authority": "human"
  },
  "evidence_sources": [
    "pr",
    "files",
    "checks",
    "context",
    "handoff"
  ],
  "context_paths": [
    ".github/CODEOWNERS",
    "AGENTS.md",
    "CLAUDE.md",
    ".passport/POLICY.md"
  ],
  "required_fields": [],
  "max_rounds": 8
}
