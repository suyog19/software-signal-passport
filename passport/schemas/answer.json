{
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "maxLength": 80
    },
    "assessed_commit": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "role": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 20
    }
  },
  "required": [
    "question_id",
    "assessed_commit",
    "role",
    "text",
    "evidence"
  ],
  "additionalProperties": false
}
